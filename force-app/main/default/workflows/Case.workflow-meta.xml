<?xml version="1.0" encoding="UTF-8" ?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>ServDeck_Case_Acknowledgement</fullName>
        <description
    >Requester gets the case number and expected resolution time. Sent by the Case - After Create flow.</description>
        <protected>false</protected>
        <recipients>
            <field>ContactId</field>
            <type>contactLookup</type>
        </recipients>
        <recipients>
            <field>SuppliedEmail</field>
            <type>email</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>ServDeck/Case_Acknowledgement</template>
    </alerts>
    <alerts>
        <fullName>ServDeck_Case_Feedback_Request</fullName>
        <description
    >Requester is asked to rate the service after the case closes. Sent by the Case - After Close flow.</description>
        <protected>false</protected>
        <recipients>
            <field>ContactId</field>
            <type>contactLookup</type>
        </recipients>
        <recipients>
            <field>SuppliedEmail</field>
            <type>email</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>ServDeck/Case_Feedback_Request</template>
    </alerts>
</Workflow>
